+
+struct _CcTabletPanel
+{
+	CcPanel           parent_instance;
+
+	GtkWidget        *sw_tablet_mode;
+	GtkWidget        *sw_auto_rotation;
+
+	gboolean          init_tablet_mode;
+	gboolean          init_auto_rotation;
+};
+
+CC_PANEL_REGISTER (CcTabletPanel, cc_tablet_panel)
+
+static gboolean tablet_mode_changed_cb (GtkSwitch *button, gboolean state, gpointer user_data);
+static gboolean auto_rotation_changed_cb (GtkSwitch *button, gboolean state, gpointer user_data);
+
+
+
+static gboolean
+get_object_path (gchar **object_path, const gchar *service_name)
+{           
+	GVariant   *variant;
+	GDBusProxy *proxy;
+	GError     *error = NULL;
+
+	proxy = g_dbus_proxy_new_for_bus_sync (G_BUS_TYPE_SYSTEM,
+                                           G_DBUS_CALL_FLAGS_NONE, NULL,
+                                           "org.freedesktop.systemd1",
+                                           "/org/freedesktop/systemd1",
+                                           "org.freedesktop.systemd1.Manager", 
+                                           NULL, &error);
+
+	if (!proxy) {
+		g_error_free (error);
+		return FALSE;
+	}
+
+	variant = g_dbus_proxy_call_sync (proxy, "GetUnit",
+                                      g_variant_new ("(s)", service_name),
+                                      G_DBUS_CALL_FLAGS_NONE, -1, NULL, &error);
+
+	if (!variant) {
+		g_error_free (error);
+	} else {
+		g_variant_get (variant, "(o)", object_path);
+		g_variant_unref (variant);
+	}
+
+	g_object_unref (proxy);
+
+	return TRUE;
+}
+
+static gboolean
+is_systemd_service_active (const gchar *service_name)
+{
+	gboolean ret = FALSE;
+
+	GVariant   *variant;
+	GDBusProxy *proxy;
+	GError     *error = NULL;
+	gchar      *obj_path = NULL;
+
+	get_object_path (&obj_path, service_name);
+	if (!obj_path) { 
+		goto done;
+	}
+
+	proxy = g_dbus_proxy_new_for_bus_sync (G_BUS_TYPE_SYSTEM,
+                                           G_DBUS_CALL_FLAGS_NONE, NULL,
+                                           "org.freedesktop.systemd1",
+                                           obj_path,
+                                           "org.freedesktop.DBus.Properties",
+                                           NULL, &error);
+
+	if (!proxy) {
+		goto done;
+	}
+
+	variant = g_dbus_proxy_call_sync (proxy, "GetAll",
+                                      g_variant_new ("(s)", "org.freedesktop.systemd1.Unit"),
+                                      G_DBUS_CALL_FLAGS_NONE, -1, NULL, &error);
+
+	if (variant) {
+		gchar *output = NULL;
+		GVariant *asv = g_variant_get_child_value(variant, 0);
+		GVariant *value = g_variant_lookup_value(asv, "ActiveState", NULL);
+		if(value && g_variant_is_of_type(value, G_VARIANT_TYPE_STRING)) {
+			output = g_variant_dup_string(value, NULL);
+			if (g_strcmp0 (output, "active") == 0) {
+				ret = TRUE;;
+			}
+			g_free (output);
+		}
+
+		g_variant_unref (variant);
+	}
+
+	g_object_unref (proxy);
+
+done:
+	if (error)
+		g_error_free (error);
+
+	return ret;
+}
+
+static gboolean
+launch_tablet_mode_switching_command (gboolean on)
+{
+	gboolean ret = FALSE;
+	GError *error = NULL;
+	gchar *pkexec, *cmdline;
+
+	pkexec = g_find_program_in_path ("pkexec");
+
+	if (on) {
+		cmdline = g_strdup_printf ("%s %s", pkexec, TABLET_MODE_CHANGE_HELPER);
+	} else {
+		cmdline = g_strdup_printf ("%s %s -d", pkexec, TABLET_MODE_CHANGE_HELPER);
+	}
+
+	ret = g_spawn_command_line_sync (cmdline, NULL, NULL, NULL, &error);
+	if (!ret) {
+		if (error) {
+			g_warning ("Error attempting to execute command: %s: %s", cmdline, error->message);
+			g_error_free (error);
+		} else {
+			g_warning ("Error attempting to execute command: %s", cmdline);
+		}
+	}
+
+	g_free (cmdline);
+
+	return ret; 
+}
+
+static gboolean
+launch_tablet_mode_ar_service_command (gboolean on)
+{
+	gboolean ret = FALSE;
+	GError *error = NULL;
+	gchar *pkexec, *cmdline;
+
+	pkexec = g_find_program_in_path ("pkexec");
+
+	if (on) {
+		cmdline = g_strdup_printf ("%s %s -a", pkexec, TABLET_MODE_AR_SERVICE_HELPER);
+	} else {
+		cmdline = g_strdup_printf ("%s %s -d", pkexec, TABLET_MODE_AR_SERVICE_HELPER);
+	}
+
+	ret = g_spawn_command_line_sync (cmdline, NULL, NULL, NULL, &error);
+	if (!ret) {
+		if (error) {
+			g_warning ("Error attempting to execute command: %s: %s", cmdline, error->message);
+			g_error_free (error);
+		} else {
+			g_warning ("Error attempting to execute command: %s", cmdline);
+		}
+	}
+
+	g_free (cmdline);
+
+	return ret;
+}
+
+static void
+switching_error_dialog_response_cb (GtkDialog *dialog,
+                                    gint       response_id,
+                                    gpointer   user_data)
+{
+	CcTabletPanel *self = CC_TABLET_PANEL (user_data);
+
+	g_signal_handlers_block_by_func (self->sw_tablet_mode, tablet_mode_changed_cb, self);
+	gtk_switch_set_active (GTK_SWITCH (self->sw_tablet_mode), self->init_tablet_mode);
+	g_signal_handlers_unblock_by_func (self->sw_tablet_mode, tablet_mode_changed_cb, self);
+
+	gtk_window_destroy (GTK_WINDOW (dialog));
+}
+
+static void
+error_dialog_response_cb (GtkDialog *dialog,
+                          gint       response_id,
+                          gpointer   user_data)
+{
+	CcTabletPanel *self = CC_TABLET_PANEL (user_data);
+
+	if (launch_tablet_mode_switching_command (self->init_tablet_mode)) {
+		g_signal_handlers_block_by_func (self->sw_tablet_mode, tablet_mode_changed_cb, self);
+		gtk_switch_set_active (GTK_SWITCH (self->sw_tablet_mode), self->init_tablet_mode);
+		g_signal_handlers_unblock_by_func (self->sw_tablet_mode, tablet_mode_changed_cb, self);
+	}
+
+	gtk_window_destroy (GTK_WINDOW (dialog));
+}
+
+static gboolean
+logout_idle_cb (gpointer user_data)
+{
+	gchar *logout_command = NULL, *cmdline = NULL;
+	CcTabletPanel *self = CC_TABLET_PANEL (user_data);
+
+	logout_command = g_find_program_in_path ("gooroom-logout-command");
+	if (logout_command) {
+		cmdline = g_strdup_printf ("%s --logout --delay=500", logout_command);
+	} else {
+		logout_command = g_find_program_in_path ("gnome-session-quit");
+		if (logout_command) {
+			cmdline = g_strdup_printf ("%s --logout --force --no-prompt", logout_command);
+		}
+	}
+
+	if (cmdline) {
+		gboolean ret = FALSE;
+		GError *error = NULL;
+
+		ret = g_spawn_command_line_sync (cmdline, NULL, NULL, NULL, &error);
+		if (!ret) {
+			if (error) {
+				g_warning ("Error attempting to execute command: %s: %s", cmdline, error->message);
+				g_error_free (error);
+			} else {
+				g_warning ("Error attempting to execute command: %s", cmdline);
+			}
+		}
+		self->init_tablet_mode = !self->init_tablet_mode;
+		g_free (cmdline);
+	} else {
+		const gchar *msg;
+		GtkWidget *dialog;
+
+		msg = _("Not found logout command.\n"
+                "Install gooroom-logout or gnome-session-bin packages.");
+
+		dialog = gtk_message_dialog_new (NULL,
+                                         GTK_DIALOG_MODAL,
+                                         GTK_MESSAGE_ERROR,
+                                         GTK_BUTTONS_CLOSE,
+                                         NULL);
+
+		gtk_message_dialog_format_secondary_text (GTK_MESSAGE_DIALOG (dialog), "%s", msg);
+		gtk_window_set_title (GTK_WINDOW (dialog), _("System Logout Error"));
+		gtk_window_present (GTK_WINDOW (dialog));
+
+		g_signal_connect (dialog, "response",
+                          G_CALLBACK (error_dialog_response_cb), self);
+	}
+
+	return FALSE;
+}
+
+static void
+tablet_mode_switching_dialog_response_cb (GtkDialog *dialog,
+                                          gint       response_id,
+                                          gpointer   user_data)
+{
+	CcTabletPanel *self = CC_TABLET_PANEL (user_data);
+
+	if (response_id == GTK_RESPONSE_YES) {
+		g_idle_add ((GSourceFunc) logout_idle_cb, self);
+		goto done;
+	}
+
+	if (launch_tablet_mode_switching_command (self->init_tablet_mode)) {
+		g_signal_handlers_block_by_func (self->sw_tablet_mode, tablet_mode_changed_cb, self);
+		gtk_switch_set_active (GTK_SWITCH (self->sw_tablet_mode), self->init_tablet_mode);
+		g_signal_handlers_unblock_by_func (self->sw_tablet_mode, tablet_mode_changed_cb, self);
+	}
+
+done:
+	gtk_window_destroy (GTK_WINDOW (dialog));
+}
+
+
+static gboolean
+tablet_mode_changed_cb (GtkSwitch *button, gboolean state, gpointer user_data)
+{
+	GtkNative *native;
+	CcTabletPanel *self = CC_TABLET_PANEL (user_data);
+
+	if (state == self->init_tablet_mode)
+		return FALSE;
+
+	native = gtk_widget_get_native (GTK_WIDGET (self));
+
+	if (launch_tablet_mode_switching_command (state)) {
+		GtkWidget *dialog;
+		const gchar *msg, *title;
+
+		if (state) {
+			title = _("Switching Tablet Mode");
+			msg = _("To switch to tablet mode, you must log in again.\n"
+                    "Would you like to log in again now?");
+		} else {
+			title = _("Switching Normal Mode");
+			msg = _("To switch to normal mode, you must log in again.\n"
+                    "Would you like to log in again now?");
+		}
+
+		dialog = gtk_message_dialog_new (GTK_WINDOW (native),
+                                         GTK_DIALOG_MODAL,
+                                         GTK_MESSAGE_ERROR,
+                                         GTK_BUTTONS_NONE,
+                                         NULL);
+		gtk_dialog_add_buttons (GTK_DIALOG (dialog),
+                                _("Yes"), GTK_RESPONSE_YES,
+                                _("No"), GTK_RESPONSE_NO,
+                                NULL);
+		gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_YES);
+
+		gtk_message_dialog_format_secondary_text (GTK_MESSAGE_DIALOG (dialog), "%s", msg);
+		gtk_window_set_title (GTK_WINDOW (dialog), title);
+		gtk_window_present (GTK_WINDOW (dialog));
+
+		g_signal_connect (dialog, "response",
+                          G_CALLBACK (tablet_mode_switching_dialog_response_cb), self);
+	} else {
+		GtkWidget *dialog;
+		const gchar *msg, *title;
+
+		if (state) {
+			title = _("Tablet Mode Switching Error");
+			msg = _("Failed to switch tablet mode.");
+		} else {
+			title = _("Normal Mode Switching Error");
+			msg = _("Failed to switch normal mode.");
+		}
+
+		dialog = gtk_message_dialog_new (GTK_WINDOW (native),
+                                         GTK_DIALOG_MODAL,
+                                         GTK_MESSAGE_ERROR,
+                                         GTK_BUTTONS_CLOSE,
+                                         NULL);
+
+		gtk_message_dialog_format_secondary_text (GTK_MESSAGE_DIALOG (dialog), "%s", msg);
+		gtk_window_set_title (GTK_WINDOW (dialog), title);
+		gtk_window_present (GTK_WINDOW (dialog));
+
+		g_signal_connect (dialog, "response",
+                          G_CALLBACK (switching_error_dialog_response_cb), self);
+	}
+
+	return FALSE;
+}
+
+static void
+auto_rotation_switching_error_dialog_response_cb (GtkDialog *dialog,
+                                                  gint       response_id,
+                                                  gpointer   user_data)
+{
+	CcTabletPanel *self = CC_TABLET_PANEL (user_data);
+
+	g_signal_handlers_block_by_func (self->sw_auto_rotation, auto_rotation_changed_cb, self);
+	gtk_switch_set_active (GTK_SWITCH (self->sw_auto_rotation), self->init_auto_rotation);
+	g_signal_handlers_unblock_by_func (self->sw_auto_rotation, auto_rotation_changed_cb, self);
+
+	gtk_window_destroy (GTK_WINDOW (dialog));
+}
+
+static gboolean
+auto_rotation_changed_cb (GtkSwitch *button, gboolean state, gpointer user_data)
+{
+	GtkNative *native;
+
+	CcTabletPanel *self = CC_TABLET_PANEL (user_data);
+
+	if (state == self->init_auto_rotation)
+		return FALSE;
+
+	native = gtk_widget_get_native (GTK_WIDGET (self));
+
+	if (!launch_tablet_mode_ar_service_command (state)) {
+		GtkWidget *dialog;
+		const gchar *msg, *title;
+
+		if (state) {
+			title = _("Auto Rotation Activating Error");
+			msg = _("Failed to activate auto rotation.");
+		} else {
+			title = _("Auto Rotation Deactivating Error");
+			msg = _("Failed to deactivate auto rotation.");
+		}
+
+		dialog = gtk_message_dialog_new (GTK_WINDOW (native),
+                                         GTK_DIALOG_MODAL,
+                                         GTK_MESSAGE_ERROR,
+                                         GTK_BUTTONS_CLOSE,
+                                         NULL);
+		gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_BUTTONS_CLOSE);
+
+		gtk_message_dialog_format_secondary_text (GTK_MESSAGE_DIALOG (dialog), "%s", msg);
+		gtk_window_set_title (GTK_WINDOW (dialog), title);
+		gtk_window_present (GTK_WINDOW (dialog));
+
+		g_signal_connect (dialog, "response",
+                          G_CALLBACK (auto_rotation_switching_error_dialog_response_cb), self);
+	} else {
+		self->init_auto_rotation = state;
+	}
+
+	return FALSE;
+}
+
+static void
+cc_tablet_panel_dispose (GObject *object)
+{
+	G_OBJECT_CLASS (cc_tablet_panel_parent_class)->dispose (object);
+}
+
+//cc_tablet_panel_constructed (GObject *object)
+//{
+//	CcShell *shell;
+//	CcTabletPanel *self = CC_TABLET_PANEL (object);
+//
+//	G_OBJECT_CLASS (cc_tablet_panel_parent_class)->constructed (object);
+//}
+
+static const char *
+cc_tablet_panel_get_help_uri (CcPanel *panel)
+{
+  return "help:gnome-help/tablet";
+}
+
+static void
+cc_tablet_panel_class_init (CcTabletPanelClass *klass)
+{
+	GObjectClass *object_class = G_OBJECT_CLASS (klass);
+	CcPanelClass *panel_class = CC_PANEL_CLASS (klass);
+	GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+	object_class->dispose = cc_tablet_panel_dispose;
+//	object_class->constructed = cc_tablet_panel_constructed;
+
+	panel_class->get_help_uri = cc_tablet_panel_get_help_uri;
+
+	gtk_widget_class_set_template_from_resource (widget_class,
+                                                 "/org/gnome/control-center/tablet/cc-tablet-panel.ui");
+
+	gtk_widget_class_bind_template_child (widget_class, CcTabletPanel, sw_tablet_mode);
+	gtk_widget_class_bind_template_child (widget_class, CcTabletPanel, sw_auto_rotation);
+}
+
+static void
+cc_tablet_panel_init (CcTabletPanel *self)
+{
+	g_resources_register (cc_tablet_get_resource ());
+
+	gtk_widget_init_template (GTK_WIDGET (self));
+
+	self->init_tablet_mode = g_file_test (ETC_GOOROOM_TABLET_MODE, G_FILE_TEST_EXISTS);
+	self->init_auto_rotation = is_systemd_service_active (IIO_SENSOR_PROXY_SERVICE);
+
+	gtk_switch_set_active (GTK_SWITCH (self->sw_tablet_mode), self->init_tablet_mode);
+	gtk_switch_set_active (GTK_SWITCH (self->sw_auto_rotation), self->init_auto_rotation);
+	if (!self->init_tablet_mode)
+		gtk_widget_set_sensitive (self->sw_auto_rotation, FALSE);
+
+	g_signal_connect (self->sw_tablet_mode, "state-set", 
+                      G_CALLBACK (tablet_mode_changed_cb), self);
+	g_signal_connect (self->sw_auto_rotation, "state-set", 
+                      G_CALLBACK (auto_rotation_changed_cb), self);
+}
