 	gtk_widget_class_bind_template_child (widget_class, CcTabletPanel, sw_tablet_mode);
 	gtk_widget_class_bind_template_child (widget_class, CcTabletPanel, sw_auto_rotation);
+	gtk_widget_class_bind_template_child (widget_class, CcTabletPanel, tablet_mode_row);
+	gtk_widget_class_bind_template_child (widget_class, CcTabletPanel, auto_rotation_row);
+	gtk_widget_class_bind_template_child (widget_class, CcTabletPanel, orientation_row);
 }
 
 static void
@@ -486,14 +694,43 @@ cc_tablet_panel_init (CcTabletPanel *self)
 
 	self->init_tablet_mode = g_file_test (ETC_GOOROOM_TABLET_MODE, G_FILE_TEST_EXISTS);
 	self->init_auto_rotation = is_systemd_service_active (IIO_SENSOR_PROXY_SERVICE);
+	self->orientation_list = G_LIST_MODEL (gtk_string_list_new (NULL));
+
+	adw_combo_row_set_model (ADW_COMBO_ROW (self->orientation_row),
+                             G_LIST_MODEL (self->orientation_list));
 
 	gtk_switch_set_active (GTK_SWITCH (self->sw_tablet_mode), self->init_tablet_mode);
 	gtk_switch_set_active (GTK_SWITCH (self->sw_auto_rotation), self->init_auto_rotation);
 	if (!self->init_tablet_mode)
 		gtk_widget_set_sensitive (self->sw_auto_rotation, FALSE);
 
+	if (!is_tablet_mode_possible ()) {
+		gtk_widget_set_sensitive (self->tablet_mode_row, FALSE);
+		gtk_widget_set_sensitive (self->auto_rotation_row, FALSE);
+		gtk_widget_set_sensitive (self->orientation_row, FALSE);
+		return;
+	}
+
+	g_timeout_add (100, (GSourceFunc)setup_orientation_cb, self);
+
 	g_signal_connect (self->sw_tablet_mode, "state-set", 
                       G_CALLBACK (tablet_mode_changed_cb), self);
 	g_signal_connect (self->sw_auto_rotation, "state-set", 
                       G_CALLBACK (auto_rotation_changed_cb), self);
+	g_signal_connect (self->orientation_row, "notify::selected-item",
+                      G_CALLBACK (on_orientation_selection_changed_cb), self);
+}
+
+void
+cc_tablet_panel_static_init_func (void)
+{
+	CcApplication *application;
+
+	application = CC_APPLICATION (g_application_get_default ());
+
+	cc_shell_model_set_panel_visibility (cc_application_get_model (application),
+                                         "tablet",
+                                         CC_PANEL_VISIBLE);
+
+	g_debug ("Tablet panel visible: yes");
 }
