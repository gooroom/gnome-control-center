@@ -466,6 +670,7 @@ cc_tablet_panel_class_init (CcTabletPanelClass *klass)
 	GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
 
 	object_class->dispose = cc_tablet_panel_dispose;
+	object_class->finalize = cc_tablet_panel_finalize;
 //	object_class->constructed = cc_tablet_panel_constructed;
 
 	panel_class->get_help_uri = cc_tablet_panel_get_help_uri;
