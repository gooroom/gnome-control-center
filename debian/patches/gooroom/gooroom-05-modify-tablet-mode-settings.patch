+static const gchar *
+string_for_rotation (DisplayRotation rotation)
+{
+	switch (rotation)
+	{
+		case DISPLAY_ROTATION_NONE:
+			return _("Landscape");
+		case DISPLAY_ROTATION_90:
+			return _("90 degree - Portrait Right");
+		case DISPLAY_ROTATION_270:
+			return _("270 degree - Portrait Left");
+		case DISPLAY_ROTATION_180:
+			return _("180 degree - Landscape (flipped)");
+	}
+
+	return "";
+}
+
+static gchar *
+get_current_display_rotation (void)
+{
+	GError *error = NULL;
+	gchar *output = NULL;
+
+	// xrandr --query --verbose | grep "primary" | cut -d ' ' -f 6
+	g_spawn_command_line_sync (GET_CURRENT_DISPLAY_ORIENTATION, &output, NULL, NULL, &error);
+	if (error) {
+		g_warning ("Failed to run '%s': %s", GET_CURRENT_DISPLAY_ORIENTATION, error->message);
+		g_clear_error (&error);
+		return NULL;
+	}
+
+	g_debug ("Current display rotation: %s", output);
+
+	return output;
+}
+
+static gboolean
+setup_orientation_cb (gpointer user_data)
+{
+	guint i, select_row;
+	gchar *str_current_rotation = NULL;
+	CcTabletPanel *self = CC_TABLET_PANEL (user_data);
+
+	DisplayRotation rotations[] = { DISPLAY_ROTATION_NONE,
+                                    DISPLAY_ROTATION_90,
+                                    DISPLAY_ROTATION_270,
+                                    DISPLAY_ROTATION_180 };
+
+	str_current_rotation = get_current_display_rotation ();
+
+	gtk_string_list_splice (GTK_STRING_LIST (self->orientation_list),
+			0,
+			g_list_model_get_n_items (self->orientation_list),
+			NULL);
+
+	for (i = 0; i < G_N_ELEMENTS (rotations); i++) {
+		g_autoptr(GObject) obj = NULL;
+
+		gtk_string_list_append (GTK_STRING_LIST (self->orientation_list),
+				string_for_rotation (rotations[i]));
+		obj = g_list_model_get_item (self->orientation_list, i);
+		g_object_set_data (G_OBJECT (obj), "rotation-value", GINT_TO_POINTER (rotations[i]));
+	}
+
+	if (!str_current_rotation) {
+		select_row = 0;
+	} else {
+		if (g_str_equal (str_current_rotation, "normal")) {
+			select_row = 0;
+		} else if (g_str_equal (str_current_rotation, "left")) {
+			select_row = 1;
+		} else if (g_str_equal (str_current_rotation, "right")) {
+			select_row = 2;
+		} else if (g_str_equal (str_current_rotation, "inverted")) {
+			select_row = 3;
+		} else {
+			select_row = 0;
+		}
+	}
+
+	adw_combo_row_set_selected (ADW_COMBO_ROW (self->orientation_row), select_row);
+
+	return FALSE;
+}
+
+static void
+on_orientation_selection_changed_cb (GtkWidget         *widget,
+                                     GParamSpec        *pspec,
+                                     gpointer           user_data)
+{
+	gint idx;
+	GError *error = NULL;
+	gchar *cmdline = NULL;
+	const gchar *str_rotation;
+	CcTabletPanel *self = CC_TABLET_PANEL (user_data);
+
+	idx = adw_combo_row_get_selected (ADW_COMBO_ROW (self->orientation_row));
+	if (idx == 0)
+		str_rotation = "normal";
+	else if (idx == 1) {
+		str_rotation = "left";
+	} else if (idx == 2) {
+		str_rotation = "right";
+	} else if (idx == 3){
+		str_rotation = "inverted";
+	} else {
+		str_rotation = NULL;
+	}
+
+	if (str_rotation) {
+		cmdline = g_strdup_printf ("xrandr -o %s", str_rotation);
+	} else {
+		g_warning ("Failed to get current display orientation.");
+	}
+
+	if (cmdline) {
+		if (!g_spawn_command_line_async (cmdline, &error)) {
+			if (error) {
+				g_warning ("Failed to launch '%s': %s", cmdline, error->message);
+				g_error_free (error);
+			} else {
+				g_warning ("Failed to launch '%s'", cmdline);
+			}
+		}
+	}
+
+	g_clear_pointer (&cmdline, g_free);
+}
+
 static void
 cc_tablet_panel_dispose (GObject *object)
 {
 	G_OBJECT_CLASS (cc_tablet_panel_parent_class)->dispose (object);
 }
 
+static void
+cc_tablet_panel_finalize (GObject *object)
+{
+	CcTabletPanel *self = CC_TABLET_PANEL (object);
+
+	g_clear_object (&self->orientation_list);
+
+	G_OBJECT_CLASS (cc_tablet_panel_parent_class)->finalize (object);
+}
