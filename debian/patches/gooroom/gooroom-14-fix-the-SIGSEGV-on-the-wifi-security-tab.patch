+		nma_utils_update_password_storage (GTK_WIDGET (self->password_entry), secret_flags,
 	                                   NM_SETTING (s_wireless_sec), NM_SETTING_WIRELESS_SECURITY_PSK);
 
 	wireless_security_clear_ciphers (connection);
