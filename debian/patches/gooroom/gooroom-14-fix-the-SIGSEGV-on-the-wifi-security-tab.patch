@@ -39,6 +39,16 @@ struct _WirelessSecurityWPAPSK {
 	GtkCheckButton *show_password_check;
 	GtkComboBox    *type_combo;
 	GtkLabel       *type_label;
+	gboolean		validate;
+};
+
+typedef enum {
+    ITEM_STORAGE_USER    = 0,
+    ITEM_STORAGE_SYSTEM  = 1,
+    ITEM_STORAGE_ASK     = 2,
+    ITEM_STORAGE_UNUSED  = 3,
+    __ITEM_STORAGE_MAX,
+    ITEM_STORAGE_MAX = __ITEM_STORAGE_MAX - 1,
 };
 
 static void wireless_security_iface_init (WirelessSecurityInterface *);
@@ -67,6 +77,7 @@ validate (WirelessSecurity *security, GError **error)
 	secret_flags = nma_utils_menu_to_secret_flags (GTK_WIDGET (self->password_entry));
